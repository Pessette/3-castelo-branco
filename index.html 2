*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
scroll-behavior:smooth;
}

body{
background:#0f1115;
color:white;
overflow-x:hidden;
}

nav{
position:fixed;
top:0;
left:0;
width:100%;
height:70px;
display:flex;
justify-content:space-between;
align-items:center;
padding:0 60px;
background:rgba(15,17,21,.95);
backdrop-filter:blur(15px);
z-index:1000;
border-bottom:1px solid rgba(255,255,255,.08);
}

.logo{
font-size:26px;
font-weight:700;
color:#a855f7;
}

.menu a{
text-decoration:none;
color:white;
margin-left:30px;
transition:.3s;
font-weight:500;
}

.menu a:hover{
color:#a855f7;
}

.slide{
width:100%;
min-height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
padding:120px 8%;
animation:fade 1s;
}

@keyframes fade{

from{
opacity:0;
transform:translateY(30px);
}

to{
opacity:1;
transform:translateY(0);
}

}

h1{
font-size:60px;
margin-bottom:20px;
}

h2{
margin:20px 0;
}

p{
font-size:20px;
max-width:900px;
text-align:center;
line-height:1.8;
color:#d6d6d6;
}

.livros{
display:flex;
gap:50px;
margin-top:50px;
flex-wrap:wrap;
justify-content:center;
}

.card{

width:320px;

background:#1b1d23;

border-radius:25px;

overflow:hidden;

transition:.4s;

cursor:pointer;

box-shadow:0 0 30px rgba(0,0,0,.35);

}

.card:hover{

transform:translateY(-12px);

box-shadow:0 20px 40px rgba(168,85,247,.35);

}

.card img{

width:100%;

height:420px;

object-fit:cover;

}

.card h2{

padding-top:20px;

text-align:center;

}

.card p{

padding:0 20px 25px;

font-size:16px;

}

.capa{

width:330px;

border-radius:20px;

margin:30px 0;

box-shadow:0 0 35px rgba(168,85,247,.35);

}

.autor{

width:220px;

height:220px;

border-radius:50%;

object-fit:cover;

margin:30px;

border:5px solid #a855f7;

}

ul{

margin-top:20px;

font-size:22px;

line-height:2;

}

.personagem{

background:#1b1d23;

padding:30px;

margin:20px;

border-radius:20px;

width:80%;

max-width:900px;

transition:.3s;

}

.personagem:hover{

background:#2a2d37;

transform:scale(1.02);

}

.final{

background:linear-gradient(135deg,#6d28d9,#111827);

}

.final h1{

font-size:80px;

}

::-webkit-scrollbar{

width:8px;

}

::-webkit-scrollbar-thumb{

background:#a855f7;

border-radius:20px;

}

@media(max-width:900px){

h1{

font-size:40px;

}

nav{

padding:0 20px;

}

.menu{

display:none;

}

.card{

width:90%;

}

.capa{

width:250px;

}

p{

font-size:18px;
// Navegação suave pelos links do menu
document.querySelectorAll("nav a").forEach(link => {
    link.addEventListener("click", function(e) {
        e.preventDefault();

        const destino = document.querySelector(this.getAttribute("href"));

        destino.scrollIntoView({
            behavior: "smooth"
        });
    });
});

// Animação ao aparecer na tela
const observer = new IntersectionObserver((entries) => {

    entries.forEach(entry => {

        if(entry.isIntersecting){

            entry.target.style.opacity = "1";
            entry.target.style.transform = "translateY(0)";
        }

    });

}, {threshold:0.3});

document.querySelectorAll(".slide").forEach(slide=>{

    slide.style.opacity="0";
    slide.style.transform="translateY(40px)";
    slide.style.transition="1s";

    observer.observe(slide);

});

// Efeito nos cards
document.querySelectorAll(".card").forEach(card=>{

    card.addEventListener("mouseenter",()=>{

        card.style.transform="translateY(-12px) scale(1.03)";

    });

    card.addEventListener("mouseleave",()=>{

        card.style.transform="translateY(0) scale(1)";

    });

});

// Navegação com as setas do teclado
const slides = document.querySelectorAll(".slide");
let atual = 0;

function mostrarSlide(i){
    slides[i].scrollIntoView({
        behavior:"smooth"
    });
}

document.addEventListener("keydown",(e)=>{

    if(e.key==="ArrowRight" || e.key==="PageDown"){

        if(atual < slides.length-1){
            atual++;
            mostrarSlide(atual);
        }

    }

    if(e.key==="ArrowLeft" || e.key==="PageUp"){

        if(atual > 0){
            atual--;
            mostrarSlide(atual);
        }

    }

});

// Atualiza o slide atual ao rolar
window.addEventListener("scroll",()=>{

    slides.forEach((slide,index)=>{

        const topo = slide.getBoundingClientRect().top;

        if(Math.abs(topo) < 250){

            atual = index;

        }

    });

});

// Mensagem final
console.log("Apresentação carregada com sucesso!");

}

}

